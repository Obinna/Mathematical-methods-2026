Cell[CellGroupData[{

Cell["The most powerful function in xPand", "Section",
 CellChangeTimes->{{3.584358884073675*^9, 3.584358898824773*^9}, {
  3.58437372200652*^9, 
  3.584373728258927*^9}},ExpressionUUID->"42487f93-48f6-4509-ab60-\
4101cd70c72f"],

Cell["\<\
ToxPand performs the following:

1) Conformal transformation with Conformal, 
2) Perturbation with Expandperturbation@Perturbed, 
3) The creation of a rule for the metric perturbation and the matter \
perturbations for a given gauge choice. This is done through SplitMetric and \
SplitMatter
4) The splitting of the result by SplitPerturbations 
\
\>", "Text",
 CellChangeTimes->{
  3.584358912849172*^9, {3.584358982916396*^9, 3.58435899489037*^9}, {
   3.584361519574314*^9, 
   3.58436153251962*^9}},ExpressionUUID->"48865cff-fb8a-43dc-824d-\
09b73ae2cd22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "ToxPand"}]], "Code",
 CellChangeTimes->{3.584359002393264*^9},
 CellLabel->"In[22]:=",ExpressionUUID->"40f36bf4-465a-49cd-b4c3-4f2f44789320"],

Cell[BoxData[
 RowBox[{"Missing", "[", 
  RowBox[{"\<\"UnknownSymbol\"\>", ",", "\<\"ToxPand\"\>"}], "]"}]], "Output",\

 CellChangeTimes->{3.813481674361025*^9, 3.8134817252362537`*^9, 
  4.0010742186533337`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"577640f2-f128-4a30-a2d1-16b0e9a3409f"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyToxPand", "[", 
   RowBox[{"expr_", ",", "gauge_", ",", "order_"}], "]"}], ":=", 
  RowBox[{"ToxPand", "[", 
   RowBox[{
   "expr", ",", "dg", ",", "u", ",", "du", ",", "h", ",", " ", "gauge", ",", 
    "order"}], "]"}]}]], "Code",
 CellChangeTimes->{3.584358927163936*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"cf57cd79-2f69-46e2-91a8-97124917e33f"],

Cell["For simplication purposes we define", "Text",
 CellChangeTimes->{{3.584372217161083*^9, 
  3.584372233698915*^9}},ExpressionUUID->"10d09009-6052-4177-b96f-\
79257ad4228e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"org", "[", "expr_", "]"}], ":=", 
  RowBox[{"NoScalar", "@", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"ContractMetric", "[", "expr", "]"}], ",", 
     "$PerturbationParameter", ",", "ToCanonical"}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"collect", "[", "expr_", "]"}], ":=", 
  RowBox[{"NoScalar", "@", 
   RowBox[{"Collect", "[", 
    RowBox[{"expr", ",", "$PerturbationParameter", ",", "Identity"}], 
    "]"}]}]}], "\[IndentingNewLine]"}], "Code",
 CellChangeTimes->{{3.58437224025011*^9, 3.584372273269985*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"9e3069e1-631b-4b59-9df2-07e954160d4d"]
}, Open  ]]
}, Open  ]],

