    RowBox[{
     RowBox[{
      FractionBox["1", "6"], " ", 
      RowBox[{"ExtractComponents", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"ah", "[", "]"}], "2"], " ", 
         RowBox[{"ExtractOrder", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ToxPand", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"EinsteinCD", "[", 
                RowBox[{"\[Mu]", ",", 
                 RowBox[{"-", "\[Nu]"}]}], "]"}], "+", 
               FractionBox[
                RowBox[{"\[CapitalLambda]", " ", 
                 RowBox[{"g", "[", 
                  RowBox[{"\[Mu]", ",", 
                   RowBox[{"-", "\[Nu]"}]}], "]"}]}], 
                SuperscriptBox["\[Kappa]", "2"]], "-", 
               RowBox[{
                SuperscriptBox["\[Kappa]", "2"], " ", 
                RowBox[{"Tmunu", "[", 
                 RowBox[{"\[Mu]", ",", 
                  RowBox[{"-", "\[Nu]"}]}], "]"}]}]}], ",", "dg", ",", "u", ",",
               "du", ",", "h", ",", "\<\"NewtonGauge\"\>", ",", "1"}], "]"}], 
            "/.", "\[VeryThinSpace]", 
            RowBox[{"IndexSolve", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"ExtractComponents", "[", 
                 RowBox[{
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"ah", "[", "]"}], "2"], " ", 
                   RowBox[{"ExtractOrder", "[", 
                    RowBox[{
                    RowBox[{"ToxPand", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"EinsteinCD", "[", 
                    RowBox[{"\[Mu]", ",", 
                    RowBox[{"-", "\[Nu]"}]}], "]"}], "+", 
                    FractionBox[
                    RowBox[{"\[CapitalLambda]", " ", 
                    RowBox[{"g", "[", 
                    RowBox[{"\[Mu]", ",", 
                    RowBox[{"-", "\[Nu]"}]}], "]"}]}], 
                    SuperscriptBox["\[Kappa]", "2"]], "-", 
                    RowBox[{
                    SuperscriptBox["\[Kappa]", "2"], " ", 
                    RowBox[{"Tmunu", "[", 
                    RowBox[{"\[Mu]", ",", 
                    RowBox[{"-", "\[Nu]"}]}], "]"}]}]}], ",", "dg", ",", "u", 
                    ",", "du", ",", "h", ",", "\<\"NewtonGauge\"\>", ",", 
                    "1"}], "]"}], ",", "0"}], "]"}]}], ",", "h", ",", 
                  RowBox[{"{", 
                   RowBox[{"\<\"Space\"\>", ",", "\<\"Space\"\>"}], "}"}]}], 
                 "]"}], " ", 
                RowBox[{"h", "[", 
                 RowBox[{
                  RowBox[{"-", "\[Mu]"}], ",", "\[Nu]"}], "]"}]}], "\[Equal]",
                "0"}], ",", 
              RowBox[{"Hh", "[", 
               RowBox[{
                RowBox[{"LI", "[", "0", "]"}], ",", 
                RowBox[{"LI", "[", "1", "]"}]}], "]"}]}], "]"}]}], ",", "1"}],
           "]"}]}], ",", "h", ",", 
        RowBox[{"{", 
         RowBox[{"\<\"Space\"\>", ",", "\<\"Space\"\>"}], "}"}]}], "]"}], " ", 
      RowBox[{"h", "[", 
       RowBox[{
        RowBox[{"-", "\[Mu]"}], ",", "\[Nu]"}], "]"}]}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"MakeRule", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Psi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
            RowBox[{"LI", "[", "0", "]"}]}], "]"}], ",", 
          RowBox[{"\[Phi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
            RowBox[{"LI", "[", "0", "]"}]}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"MakeRule", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Psi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
            RowBox[{"LI", "[", "1", "]"}]}], "]"}], ",", 
          RowBox[{"\[Phi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
            RowBox[{"LI", "[", "1", "]"}]}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"MakeRule", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Psi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
            RowBox[{"LI", "[", "2", "]"}]}], "]"}], ",", 
          RowBox[{"\[Phi]h", "[", 
           RowBox[{
            RowBox[{"LI", "[", "1", "]"}], ",", 
