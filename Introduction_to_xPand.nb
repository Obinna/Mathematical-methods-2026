f982d1508281"],

Cell["Typical KG equation from a minimally coupled scalar field", "Text",
 CellChangeTimes->{{3.584371242276503*^9, 
  3.584371289870413*^9}},ExpressionUUID->"40c9ff7f-f515-42fb-9f31-\
b51d9a0531e1"],

