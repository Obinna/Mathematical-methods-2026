Cell["Introduction to xAct", "Title",
 CellChangeTimes->{{3.750294763116897*^9, 3.750294769392634*^9}, {
  3.7502948531234694`*^9, 3.750294855288364*^9}, {3.750295593269246*^9, 
  3.750295601004239*^9}, {3.7502957872284117`*^9, 3.750295787824793*^9}},
 TextAlignment->Center,ExpressionUUID->"3a3ea995-92dc-419b-9285-a34f51ad5ba1"],

Cell[TextData[{
 "xAct is a suite of  tensor computer algebra packages in the Wolfram \
Language. \n\n It has for foundational kernels:\n \n1) ",
 StyleBox["xCore",
  FontWeight->"Bold"],
 ": generic programming tools.\n2) ",
 StyleBox["xPerm",
  FontWeight->"Bold"],
 ": manipulation of large groups of permutations.\n3) ",
 StyleBox["xTensor",
  FontWeight->"Bold",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 StyleBox[": abstract tensor computations.",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 "\n4) ",
 StyleBox["xCoba",
  FontWeight->"Bold"],
 ": component tensor computations.\n\nAnd several application packages:\n\n1) \
",
 StyleBox["xPert",
  FontWeight->"Bold",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 StyleBox[": high-order perturbation theory ",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 "\n2) ",
 StyleBox["Harmonics",
  FontWeight->"Bold"],
 ": tensor spherical harmonics\n3) ",
 StyleBox["Invar:",
  FontWeight->"Bold"],
 " polynomial invariants of the Riemann tensor\n4) ",
 StyleBox["Spinors",
  FontWeight->"Bold"],
 ": spinor computations in GR\n5) ",
 StyleBox["xPrint",
  FontWeight->"Bold"],
 ": Formatted input for xAct\n6) ",
 StyleBox["SymManipulator:",
  FontWeight->"Bold"],
 " Symmetrized expressions in xAct\n7) ",
 StyleBox["AVF",
  FontWeight->"Bold"],
 ": Exterior calculus with algebra-valued forms\n8) ",
 StyleBox["xTras",
  FontWeight->"Bold",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 StyleBox[": Additions to xAct",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 "\n9) ",
 StyleBox["TexAct",
  FontWeight->"Bold"],
 ": Tex code to format xAct expressions\n10) ",
 StyleBox["xPand:",
  FontWeight->"Bold",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 StyleBox[" Cosmological perturbation theory",
  FontColor:>Dynamic[
    CurrentValue[{StyleHints, "ColorSet", "Display1"}]]],
 "\n11) ",
 StyleBox["xTerior",
  FontWeight->"Bold"],
 ": Exterior calculus\n12) ",
 StyleBox["SpinFrames:",
  FontWeight->"Bold"],
 " NP and GHP form of spinor equations"
}], "Text",
 CellChangeTimes->{{3.7502948205034437`*^9, 3.750294845438596*^9}, {
  3.750294979205965*^9, 3.750295073253138*^9}, {3.750295134332555*^9, 
  3.750295214186618*^9}, {3.750295268248859*^9, 3.7502953118065147`*^9}, {
  3.7502955902544107`*^9, 
  3.750295641135394*^9}},ExpressionUUID->"8f1aae10-117d-48cd-a507-\
a26c7cff245a"],

Cell[CellGroupData[{

Cell["Installation", "Subsection",
 CellChangeTimes->{
  3.7502957300033207`*^9},ExpressionUUID->"ab818f72-0b95-40cb-8f81-\
085610432fbf"],

Cell[TextData[{
 "You have to install xAct before going through the following exercise.\n\
Download from \
here:http://www.xact.es/download\[LineSeparator]\[LineSeparator]For a single \
user:\n\n",
 StyleBox["Linux",
  FontWeight->"Bold"],
 ": $HOME/.Mathematica/Applications/\n",
 StyleBox["Mac OS",
  FontWeight->"Bold"],
 ": /Users/<user>/Library/Mathematica/Applications/\n",
 StyleBox["MSWindows",
  FontWeight->"Bold"],
 ": C:\\Documents and settings\\<user>\\Application     \
Data\\Mathematica\\Applications\\\n\n\nI haven\[CloseCurlyQuote]t installed \
it on MSwindows but there are no compliants.  \n\nIf you are unable to load \
xAct documentations in Mathematica 11. You can grab a quick fix from here \
:https://github.com/Obinna/Documentation"
}], "Text",
 CellChangeTimes->{{3.750295825569233*^9, 3.750296147049932*^9}, {
   3.7502962686239767`*^9, 3.7502962854709806`*^9}, {3.7502963298987207`*^9, 
   3.750296337765656*^9}, {3.750296458836213*^9, 3.750296474057226*^9}, {
   3.750298976468728*^9, 3.750299076641637*^9}, 
   3.81348911859976*^9},ExpressionUUID->"27eebec1-c13f-4be5-a10b-\
c487f1c03e06"],

