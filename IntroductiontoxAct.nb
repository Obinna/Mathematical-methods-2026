Cell[BoxData[
 RowBox[{"SubCovDKwithLieDK", " ", "=", " ", "\[IndentingNewLine]", 
  RowBox[{"SolveTensors", "[", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GradNormalToExtrinsicK", "[", 
      RowBox[{
       RowBox[{"LieDToCovD", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"LieD", "[", 
           RowBox[{"n", "[", "a", "]"}], "]"}], "[", 
          RowBox[{"ExtrinsicKmetrich", "[", 
           RowBox[{
            RowBox[{"-", "b"}], ",", " ", 
            RowBox[{"-", "c"}]}], "]"}], "]"}], ",", " ", "CD"}], "]"}], "-", 
       
       RowBox[{
        RowBox[{"LieD", "[", 
         RowBox[{"n", "[", "a", "]"}], "]"}], "[", 
        RowBox[{"ExtrinsicKmetrich", "[", 
         RowBox[{
          RowBox[{"-", "b"}], ",", 
          RowBox[{"-", "c"}]}], "]"}], "]"}]}], "]"}], "\[Equal]", "0"}], ",", 
    RowBox[{
     RowBox[{"n", "[", "a", "]"}], 
     RowBox[{
      RowBox[{"CD", "[", 
       RowBox[{"-", "a"}], "]"}], "[", 
      RowBox[{"ExtrinsicKmetrich", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", 
        RowBox[{"-", "c"}]}], "]"}], "]"}]}]}], "]"}]}]], "Input",
