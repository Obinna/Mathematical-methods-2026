   RowBox[{
    RowBox[{"HoldPattern", "[", 
     InterpretationBox[
      StyleBox[
       RowBox[{
        SubscriptBox["\[ScriptCapitalL]", "n"], GridBox[{
          {"Kh", 
           StyleBox[GridBox[{
              {
               UnderscriptBox[
