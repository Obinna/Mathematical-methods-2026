             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}, "RowsIndexed" -> {}}]}],
       ShowAutoStyles->False,
       AutoSpacing->False],
      xAct`xTensor`LieD[
       $CellContext`n[
        PatternTest[
         Pattern[$CellContext`a, 
          Blank[]], TangentM4`pmQ]]][
       $CellContext`ExtrinsicKmetrich[
        PatternTest[
         Pattern[$CellContext`b, 
          Blank[]], TangentM4`pmQ], 
        PatternTest[
         Pattern[$CellContext`c, 
          Blank[]], TangentM4`pmQ]]],
      Editable->False], "]"}], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "a", "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         InterpretationBox[
          StyleBox[GridBox[{
             {"Kh", 
              StyleBox[GridBox[{
                 {"b", " "},
                 {" ", "a"}
                },
                GridBoxSpacings->{"Columns" -> {
                    Offset[0.], {
                    Offset[0.034999999999999996`]}, 
                    Offset[0.]}, "ColumnsIndexed" -> {}, "Rows" -> {{
                    Offset[0.]}}, "RowsIndexed" -> {}}],
               
               FontSize->Rational[3, 4] 
                Dynamic[
                 0.019 FrontEnd`AbsoluteCurrentValue[{WindowSize, 1}]]]}
            },
            
