Cell[BoxData[
 RowBox[{"EOM\[Phi]ST0", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"0", "==", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"-", 
         RowBox[{"Detg", "[", "]"}]}], "]"}]], 
      RowBox[{
       RowBox[{"VarD", "[", 
        RowBox[{
         RowBox[{"\[Delta]\[Phi]", "[", 
          RowBox[{"LI", "[", "1", "]"}], "]"}], ",", "CD"}], "]"}], "@", 
       "LSTpert"}]}]}], "/.", 
    RowBox[{
     RowBox[{"delta", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"LI", "[", "1", "]"}]}], ",", 
       RowBox[{"LI", "[", "1", "]"}]}], "]"}], "\[Rule]", "1"}]}], "//", 
   "Expand"}]}]], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"bbdb3548-42e1-4a68-bb12-235a493739a2"],

